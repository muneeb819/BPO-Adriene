# =============================================================================
# BPO Adriene — environment configuration
# Copy to .env and edit. Everything has a working default; only SECRET_KEY
# matters for a real deployment, and the LLM key is optional (local brain
# runs everything without one).
# =============================================================================

# --- required for deployment ------------------------------------------------
SECRET_KEY=change-me-to-a-long-random-string
# SQLite by default (kept in the bot-data volume / ./data). Any SQLAlchemy URL:
# DATABASE_URL=postgresql+psycopg://user:pass@host/adriene

# --- voice (fully local, no key needed) --------------------------------------
TTS_PROVIDER=kokoro            # kokoro (neural) | mock (browser voice fallback)
TTS_VOICE=af_heart             # one of 20 US-English voices — pick in the Voice Panel
TTS_SPEED=1.0                  # 0.7-1.5; Kokoro sounds best around 1.0
STT_PROVIDER=mock              # the live STT path is browser mic dictation (Web Speech API)

# --- LLM: add ONE key and the brain auto-upgrades its wording ---------------
# No key needed — "mock" runs the full local brain (NLU + Medicare KB +
# compliance + memory). Decisions always stay in the policy layer; the model
# only re-words, and any failure falls back to the local persona instantly.
# LLM_PROVIDER=openai           # openai | anthropic | gemini (informational;
#                                the key itself selects the provider)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-5
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-2.0-flash

# --- call handoff ------------------------------------------------------------
TRANSFER_PROVIDER=mock         # mock | vici (ViciDial) | twilio (SIP)
MEDIA_BRIDGE=mock

# =============================================================================
# LiveKit — run Adriene as a real LiveKit agent (see docs/LIVEKIT.md)
#   python livekit_agent.py dev        # debug mode
#   python livekit_agent.py console    # local terminal, no server
# =============================================================================
# From LiveKit Cloud -> Project Settings -> Keys, or `livekit-server --dev`.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxxxx
LIVEKIT_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Blank = automatic dispatch (worker joins every new room).
# Named = only rooms whose token explicitly dispatches this agent
# (the bundled debug console does that for you).
LIVEKIT_AGENT_NAME=

# Warm transfer (SIP). Blank = end the call after the transfer line.
LIVEKIT_TRANSFER_NUMBER=

# auto = use a cloud key when present, otherwise the local engine
LIVEKIT_STT_PROVIDER=auto       # auto | deepgram | openai | faster_whisper | none
LIVEKIT_TTS_PROVIDER=auto       # auto | local | openai | elevenlabs | none
LIVEKIT_LLM_PROVIDER=brain      # brain (scripted, compliant) | openai | anthropic | gemini

# local neural voice (python scripts/fetch_neural_voices.py)
LIVEKIT_TTS_VOICE=
LIVEKIT_TTS_SPEED=1.0
LIVEKIT_TTS_PITCH=50

# local speech recognition (pip install faster-whisper)
LIVEKIT_STT_MODEL=base.en
LIVEKIT_STT_DEVICE=cpu
LIVEKIT_STT_COMPUTE=int8
