# ===== DEBUG MODE (local testing, no PBX / no keys needed) =====
# true = show DEBUG badge, verbose beat logs; bot still works with real keys on.
DEBUG=true

# ===== LLM PROVIDER =====
# openai | anthropic | ollama
# TIP: no key? Leave blank — debug mode falls back to the built-in MockLLM (free, offline).
LLM_PROVIDER=anthropic
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# ===== FRONTER / BUSINESS =====
AGENT_NAME=Lina
BUSINESS_NAME=Senior Resource Center
BRAND_VOICE=warm, mature, unhurried, emotionally present

# ===== STT (mic/voice input) =====
# console = type in the debug console (free, no key)
# deepgram = real microphone transcription (needs DEEPGRAM_API_KEY — free $200 credit, no card)
STT_PROVIDER=console
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2

# ===== TTS — Lina's voice (voice output) =====
# console    = text only (free, no key)
# elevenlabs = cloud, expressive streaming voice (needs ELEVENLABS_API_KEY)
# kokoro     = self-hosted, free, OpenAI-compatible (see start-kokoro.ps1)
#              POST http://localhost:8880/v1/audio/speech, outputs 24 kHz PCM
TTS_PROVIDER=console
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE=Jessica
ELEVENLABS_MODEL=eleven_v3
# Soft, sweet, caring young woman's voice
ELEVENLABS_STABILITY=0.5
ELEVENLABS_SIMILARITY_BOOST=0.9
ELEVENLABS_STYLE=0.4
ELEVENLABS_SPEAKER_BOOST=true
# Standby engine — used automatically if the primary fails mid-call, and
# switched back to once the primary is reachable again. Empty = no failover.
TTS_STANDBY_PROVIDER=kokoro
# Kokoro (primary OR standby — leave as standby unless you prefer local voice)
KOKORO_BASE_URL=http://localhost:8880
KOKORO_API_KEY=not-needed
KOKORO_MODEL=kokoro
KOKORO_VOICE=af_bella          # warm female; also af_heart, af_sarah, af_nicole
KOKORO_SPEED=1.0
KOKORO_TIMEOUT=30

# ChatterBox (Resemble AI open-source TTS — local, no API key needed)
# Models: turbo (350M, English, paralinguistic tags), nano (110M, English, CPU 3x realtime),
#         multilingual (500M, 23+ languages), original (500M, English)
CHATTERBOX_MODEL=turbo
CHATTERBOX_DEVICE=cpu                    # cpu or cuda
CHATTERBOX_VOICE_PATH=                   # path to reference audio for voice cloning (10s+)
CHATTERBOX_LANGUAGE=en                   # language code for multilingual
CHATTERBOX_EXAGGERATION=0.5
CHATTERBOX_CFG_WEIGHT=0.5
CHATTERBOX_TEMPERATURE=0.8
POSITIVE_CONFIDENCE_THRESHOLD=0.85
NEGATIVE_CONFIDENCE_THRESHOLD=0.85
DNC_CONFIDENCE_THRESHOLD=0.75
MAX_CLARIFY_ATTEMPTS=1

# ===== COMPLIANCE =====
CALLING_HOUR_START=8
CALLING_HOUR_END=21

# ===== ASTERISK ARI / TRANSFER =====
ARI_URL=http://localhost:8088
ARI_APP=final-expense-fronter
ARI_USERNAME=ari
ARI_PASSWORD=
ARI_OUTBOUND_CONTEXT=from-internal
CLOSER_QUEUE=closers
CLOSER_EXTENSION=
ASTERISK_SOUNDS_DIR=/var/lib/asterisk/sounds/en
ARI_RECORDINGS_DIR=/var/spool/asterisk/monitor

# ===== VICIDIAL (optional, logs dispositions) =====
VICIDIAL_URL=
VICIDIAL_USER=
VICIDIAL_PASS=
VICIDIAL_SOURCE=AIFRONTER

# ===== SERVER =====
HOST=0.0.0.0
PORT=8000
WEB_PASSWORD=
DATA_DIR=data
