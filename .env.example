# =============================================================================
# BPO Adriene — environment configuration
#
# Copy to .env and edit:   cp .env.example .env
#
# Every setting below is optional EXCEPT SECRET_KEY, which must be set to a
# long random string before the dashboard is reachable by anyone but you.
# With nothing but SECRET_KEY the bot runs fully locally and keyless.
#
# Grouped by provider. "required" = the app will refuse to start without it.
# Comments say when a value is needed versus merely useful.
# =============================================================================

# --- core -------------------------------------------------------------------
# REQUIRED. No default is shipped on purpose: generate one with
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# The launchers refuse to start when this is unset.
SECRET_KEY=

# Optional. SQLAlchemy URL. Defaults to SQLite at ./dev.db (the bot-data volume
# in Docker). Example: postgresql+psycopg://user:pass@host/adriene
DATABASE_URL=

# Optional. 0 = production. 1 = verbose logging and tracebacks in responses.
DEBUG=0

# Optional. ERROR | WARNING | INFO | DEBUG. Defaults to INFO.
LOG_LEVEL=INFO

# Optional. Where the self-learning memory JSON lives. Defaults to data/.
BRAIN_MEMORY_PATH=

# Optional. Where call logs, recordings and the voice library are written.
DATA_DIR=data

# Optional. Saved voice library (library / design / remix). Defaults to data/voices.
VOICE_LIBRARY_DIR=data/voices

# Optional. HuggingFace cache for the Kokoro model (~330 MB, downloaded once).
HF_HOME=

# --- HTTP server ------------------------------------------------------------
# Optional. Bind address and port. The launchers and Dockerfile use 8055;
# change here only if you also change the launcher, or the docs will lie.
HOST=0.0.0.0
PORT=8055

# Optional but STRONGLY recommended whenever the dashboard is reachable by
# anyone but you: without WEB_PASSWORD the console is open to the LAN, and
# visitors can place calls and read call logs. Leave empty only on localhost.
# This is the dashboard password, not the secret key — use a different value.
WEB_PASSWORD=

# --- persona and script -----------------------------------------------------
# Optional. Shown in the script and used by the LLM prompt.
AGENT_NAME=Lina
BUSINESS_NAME=Final Expense Solutions
BRAND_VOICE=natural, warm, conversational, expressive, empathetic

# Optional. Comma-separated states the bot may sell in. Defaults to 14 states.
LICENSED_STATES=

# Optional. Eligibility bounds; callers outside this range are screened out.
MIN_AGE=50
MAX_AGE=85

# Optional. Confidence gates for the NLU before the script advances.
POSITIVE_CONFIDENCE_THRESHOLD=0.85
NEGATIVE_CONFIDENCE_THRESHOLD=0.85
DNC_CONFIDENCE_THRESHOLD=0.75
MAX_CLARIFY_ATTEMPTS=1

# Optional. TCPA calling window, 24h clock, local time.
CALLING_HOUR_START=8
CALLING_HOUR_END=21

# --- LLM: add ONE key and the brain auto-upgrades its wording ---------------
# No key needed — "mock" runs the full local brain (NLU + Medicare KB +
# compliance + memory). Decisions always stay in the policy layer; the model
# only re-words, and any failure falls back to the local persona instantly.
LLM_PROVIDER=anthropic          # anthropic | openai | gemini | ollama | mock

# Optional. OpenAI — also enables OpenAI TTS/STT upgrades elsewhere.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=                # set for a proxy or a self-hosted gateway

# Optional. Anthropic.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Optional. Google Gemini. GOOGLE_API_KEY is accepted as an alias by some paths.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GOOGLE_API_KEY=

# Optional. Local Ollama — no key, runs on your machine.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# =============================================================================
# Voice output (TTS)
# =============================================================================

# Which engine speaks. kokoro (neural, in-process, keyless) is the documented
# default; mock is the browser-voice fallback; the rest need keys or a server.
#   kokoro | piper | chatterbox | elevenlabs | openai | azure | deepgram | mock
TTS_PROVIDER=kokoro
TTS_VOICE=af_heart             # one of 20 US-English voices — pick in the Voice Panel
TTS_SPEED=1.0                  # 0.7-1.5; Kokoro sounds best around 1.0

# Standby engine, used automatically when the primary fails mid-call and
# promotable to primary by swapping TTS_PROVIDER. Empty = no failover.
TTS_STANDBY_PROVIDER=

# --- Kokoro (in-process, keyless — the default engine) ----------------------
# The app runs Kokoro itself; these only matter if you point it at a remote
# OpenAI-compatible Kokoro server instead.
KOKORO_BASE_URL=http://localhost:8880
KOKORO_API_KEY=not-needed
KOKORO_MODEL=kokoro
KOKORO_VOICE=af_bella
KOKORO_SPEED=1.0
KOKORO_PITCH=0                 # 0 = the server's own default
KOKORO_TIMEOUT=30

# --- Piper / local ONNX voices (keyless) ------------------------------------
# Needs the voice models: python scripts/fetch_neural_voices.py
# Served by scripts/neural_tts_server.py on PIPER_BASE_URL.
PIPER_BASE_URL=http://127.0.0.1:8880
PIPER_API_KEY=not-needed
PIPER_MODEL=piper
PIPER_VOICE=                   # "" = the server picks the middle voice
PIPER_SPEED=1.0
PIPER_PITCH=50                 # 0-99 studio scale, 50 = no shift
PIPER_VOLUME=1.0
PIPER_SAMPLE_RATE=16000
PIPER_TIMEOUT=30
PIPER_MODELS_DIR=              # override the data/models/piper default

# --- ChatterBox (Resemble AI, open source; voice cloning) -------------------
# Optional: needs the chatterbox package and, on CPU, the nano or turbo model.
CHATTERBOX_MODEL=turbo         # turbo | nano | multilingual
CHATTERBOX_DEVICE=cpu          # cuda | cpu | mps
CHATTERBOX_VOICE_PATH=         # 10s+ reference audio for cloning
CHATTERBOX_LANGUAGE=en
CHATTERBOX_EXAGGERATION=0.5
CHATTERBOX_CFG_WEIGHT=0.5
CHATTERBOX_TEMPERATURE=0.8

# --- ElevenLabs (cloud, needs a key) ----------------------------------------
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE=Rachel
ELEVENLABS_MODEL=eleven_v3
ELEVENLABS_STABILITY=0.65
ELEVENLABS_SIMILARITY_BOOST=0.75
ELEVENLABS_STYLE=0.3
ELEVENLABS_SPEAKER_BOOST=1
ELEVENLABS_VOICE_ID=         # optional; use a saved library voice id instead of a stock voice

# --- Azure Speech (cloud, needs a key) --------------------------------------
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_VOICE=en-US-AriaNeural

# --- OpenAI TTS (cloud, needs a key) ----------------------------------------
OPENAI_TTS_API_KEY=
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy

# =============================================================================
# Speech recognition (STT)
# =============================================================================
# mock = browser mic dictation (Web Speech API), no key — the local default.
# console = type your replies in a terminal session. deepgram = live server STT.
STT_PROVIDER=mock              # mock | console | deepgram
DEEPGRAM_API_KEY=              # required only when STT_PROVIDER=deepgram
DEEPGRAM_MODEL=nova-2
OPENAI_STT_MODEL=whisper-1   # optional; used when STT is routed through OpenAI

# =============================================================================
# Call handoff
# =============================================================================
TRANSFER_PROVIDER=mock         # mock | vici (ViciDial) | twilio (SIP)
MEDIA_BRIDGE=mock

# --- ViciDial (needs a server) ----------------------------------------------
VICIDIAL_URL=
VICIDIAL_USER=
VICIDIAL_PASS=
VICIDIAL_SOURCE=AIFRONTER

# --- Asterisk ARI (needs an Asterisk box) -----------------------------------
ARI_URL=http://localhost:8088
ARI_APP=final-expense-fronter
ARI_USERNAME=ari
ARI_PASSWORD=
ARI_OUTBOUND_CONTEXT=from-internal
CLOSER_QUEUE=closers
CLOSER_EXTENSION=
ASTERISK_SOUNDS_DIR=/var/lib/asterisk/sounds/en
ARI_RECORDINGS_DIR=/var/spool/asterisk/monitor

# =============================================================================
# LiveKit — run Adriene as a real LiveKit agent (see docs/LIVEKIT.md)
#   python livekit_agent.py dev        # debug mode
#   python livekit_agent.py console    # local terminal, no server
# =============================================================================
# From LiveKit Cloud -> Project Settings -> Keys, or `livekit-server --dev`.
# REQUIRED only for the LiveKit worker; the console app ignores these.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxxxx
LIVEKIT_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Blank = automatic dispatch (worker joins every new room).
# Named = only rooms whose token explicitly dispatches this agent
# (the bundled debug console does that for you).
LIVEKIT_AGENT_NAME=

# Warm transfer (SIP). Blank = end the call after the transfer line.
LIVEKIT_TRANSFER_NUMBER=

# auto = use a cloud key when present, otherwise the local engine
LIVEKIT_STT_PROVIDER=auto       # auto | deepgram | openai | faster_whisper | none
LIVEKIT_TTS_PROVIDER=auto       # auto | local | openai | elevenlabs | none
LIVEKIT_LLM_PROVIDER=brain      # brain (scripted, compliant) | openai | anthropic | gemini

# local neural voice (python scripts/fetch_neural_voices.py)
LIVEKIT_TTS_VOICE=
LIVEKIT_TTS_SPEED=1.0
LIVEKIT_TTS_PITCH=50

# local speech recognition (pip install faster-whisper)
LIVEKIT_STT_MODEL=base.en
LIVEKIT_STT_DEVICE=cpu
LIVEKIT_STT_COMPUTE=int8
LIVEKIT_STT_LANGUAGE=

# Optional. Where the worker writes its own call log; defaults to data/.
LIVEKIT_CALL_LOG_DIR=
# Optional. 1 = verbose worker logging.
LIVEKIT_DEBUG=0
# Optional. Seconds to wait for the caller to say hello before re-prompting.
LIVEKIT_GREETING_WAIT=

# =============================================================================
# Standalone neural voice server (scripts/neural_tts_server.py)
# Not needed by the console app — it runs Kokoro in-process.
# =============================================================================
NEURAL_TTS_HOST=127.0.0.1
NEURAL_TTS_PORT=8880
NEURAL_TTS_QUIET=0

# =============================================================================
# QA harness (backend/scripts/qa_runner.py)
# =============================================================================
# Optional. Voice and speed used for recorded QA turns.
QA_TTS_VOICE=
QA_TTS_SPEED=1.0
QA_TTS_TIMEOUT=60
