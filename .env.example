# =============================================================================
#  BPO Adriene — AI Voice Fronter :: .env
#  Copy this file to `.env` and edit it. Every value below is what the app uses
#  when the line is missing, so you only need to change what you care about.
#
#  Windows:  copy .env.example .env
#  Linux:    cp  .env.example .env
#  Setup:    python scripts/setup_local.py       (does this for you)
#  Check:    python scripts/healthcheck.py       (says what is missing)
# =============================================================================

# ===== RUNTIME MODE =====
# DEBUG=false  production: ARI/PBX calls, no demo, quiet logs  (a live server)
# DEBUG=true   the dashboard shows a DEBUG badge and the console runs a scripted
#              demo call; voice keys still work. `start.ps1` (no -Serve) sets this.
DEBUG=false

# ===== LLM PROVIDER =====
# anthropic | openai | gemini | ollama
# A key is OPTIONAL: with none set the bot speaks the compliance script lines
# from the campaign (deterministic, free). A key makes the wording natural.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# ===== AGENT / BUSINESS =====
AGENT_NAME=Lina
BUSINESS_NAME=Senior Resource Center
BRAND_VOICE=warm, mature, unhurried, emotionally present
# States you are licensed in (comma separated, uppercase) — used by the gate.
LICENSED_STATES=AZ,CA,TX,FL,OH,GA,NC,TN,IL,PA,MI,VA,IN,MO
# Age window the bot will transfer for.
MIN_AGE=50
MAX_AGE=85

# ===== STT — speech the bot hears (phone calls) =====
# console  = typed input in the debug console (free, no key, dashboard only)
# deepgram = real call audio transcription. NEEDED FOR LIVE CALLS.
#            Free $200 credit, no card: https://deepgram.com
STT_PROVIDER=console
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2

# ===== TTS — the voice the callers hear =====
# piper      = RECOMMENDED LOCAL ENGINE. Real neural voices (Piper/ONNX) on CPU,
#              no torch, no key, offline. Start the bundled server first:
#                python scripts/fetch_neural_voices.py                 # once, ~60 MB/voice
#                python scripts/neural_tts_server.py --port 8880 --warm
#              start.ps1 / start.sh do this automatically.
# elevenlabs = cloud, most expressive (needs ELEVENLABS_API_KEY)
# kokoro     = a real Kokoro server, same wire format as the Piper one
# chatterbox = local cloning engine (needs `pip install chatterbox-tts` + weights)
# console    = no audio at all (text only) — for CI, not for a call centre
TTS_PROVIDER=piper
# Standby engine: used automatically when the primary fails mid-call and
# promoted for the rest of the call. Empty = no failover.
# Only name an engine that is actually installed on this server.
TTS_STANDBY_PROVIDER=

# --- Local neural voices (Piper) — the default engine ------------------------
# Both names below point at the same bundled OpenAI-compatible server; PIPER_* is
# what the studio uses to render, match and design voices.
PIPER_BASE_URL=http://127.0.0.1:8880
PIPER_API_KEY=not-needed
PIPER_MODEL=piper
PIPER_VOICE=en_US-amy-low        # empty = the server picks the middle voice
PIPER_SPEED=1.0
PIPER_PITCH=50                   # studio scale 0-99, 50 = the voice's own pitch
PIPER_VOLUME=1.0
PIPER_SAMPLE_RATE=16000          # the bundled server always answers at 16 kHz
PIPER_TIMEOUT=30

# --- Kokoro (only if you run a real Kokoro/faster-whisper stack) -------------
# The bundled Piper server answers on this URL too, so both names work; a real
# Kokoro server returns 24 kHz PCM and the pipeline resamples it automatically.
KOKORO_BASE_URL=http://127.0.0.1:8880
KOKORO_API_KEY=not-needed
KOKORO_MODEL=kokoro
KOKORO_VOICE=af_bella            # af_bella, af_heart, af_sarah, af_nicole
KOKORO_SPEED=1.0
KOKORO_PITCH=0                   # 0 = the server's own default
KOKORO_TIMEOUT=30

# --- ElevenLabs (cloud, needs a key) ----------------------------------------
# Also the only engine that can *generate* a brand-new voice from a written
# description (Voice studio → Describe a voice). Without a key the studio
# designs voices from the local neural ones instead.
# Key: https://elevenlabs.io → your profile → API keys
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE=Jessica
ELEVENLABS_MODEL=eleven_v3
ELEVENLABS_STABILITY=0.5
ELEVENLABS_SIMILARITY_BOOST=0.9
ELEVENLABS_STYLE=0.4
ELEVENLABS_SPEAKER_BOOST=true

# --- ChatterBox (local cloning; needs the package + ~2-3 GB of weights) -----
# Models: turbo (350M, English, tags), nano (110M, fast on CPU),
#         multilingual (500M, 23+ languages), original (500M, English)
CHATTERBOX_MODEL=multilingual
CHATTERBOX_DEVICE=cpu            # cpu or cuda
CHATTERBOX_VOICE_PATH=           # reference wav for cloning (10 s+), optional
CHATTERBOX_LANGUAGE=en
CHATTERBOX_EXAGGERATION=0.5
CHATTERBOX_CFG_WEIGHT=0.5
CHATTERBOX_TEMPERATURE=0.8

# --- Other cloud voices (only if you name them in TTS_PROVIDER) --------------
TTS_VOICE=aura-luna-en           # deepgram Aura voice
OPENAI_TTS_API_KEY=
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=shimmer
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_VOICE=en-US-JennyNeural

# ===== VOICE STUDIO =====
VOICE_LIBRARY_DIR=data/voices    # library.json + one wav per reference

# ===== CONVERSATION GATES =====
POSITIVE_CONFIDENCE_THRESHOLD=0.85
NEGATIVE_CONFIDENCE_THRESHOLD=0.85
DNC_CONFIDENCE_THRESHOLD=0.75
MAX_CLARIFY_ATTEMPTS=1

# ===== COMPLIANCE =====
CALLING_HOUR_START=8             # local time, 24h
CALLING_HOUR_END=21

# ===== ASTERISK ARI / TRANSFER (live calls) =====
# In Asterisk:  /etc/asterisk/ari.conf  →  user `ari`, read/write; http.conf enabled.
# Then route the DID to the Stasis app (see configs/extensions.conf.example).
ARI_URL=http://localhost:8088
ARI_APP=final-expense-fronter
ARI_USERNAME=ari
ARI_PASSWORD=
ARI_OUTBOUND_CONTEXT=from-internal
CLOSER_QUEUE=closers
CLOSER_EXTENSION=                # set this instead of a queue, if you prefer
ASTERISK_SOUNDS_DIR=/var/lib/asterisk/sounds/en
ARI_RECORDINGS_DIR=/var/spool/asterisk/monitor

# ===== VICIDIAL (optional; logs dispositions) =====
VICIDIAL_URL=
VICIDIAL_USER=
VICIDIAL_PASS=
VICIDIAL_SOURCE=AIFRONTER

# ===== WEB SERVER =====
HOST=0.0.0.0                     # 0.0.0.0 = reachable from the LAN (see WEB_PASSWORD)
PORT=8000
# Empty = no login. Set a password if the dashboard is reachable by anyone but you.
WEB_PASSWORD=
DATA_DIR=data                    # call log, recordings, campaigns, memory
