# =============================================================================
#  BPO Adriene app — systemd unit (Linux server)
#
#  Install:
#     sudo cp deploy/bpo-adriene.service /etc/systemd/system/
#     sudo systemctl daemon-reload
#     sudo systemctl enable --now bpo-adriene
#     systemctl status bpo-adriene
#     journalctl -u bpo-adriene -f
#
#  Adjust WorkingDirectory/User and put your env (SECRET_KEY, optional LLM
#  key) in /opt/bpo-adriene/.env. Readiness: GET /api/health.
# =============================================================================
[Unit]
Description=BPO Adriene - AI voice bot (FastAPI + Kokoro neural voice)
Documentation=file:///opt/bpo-adriene/DEPLOYMENT.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bpo
Group=bpo
WorkingDirectory=/opt/bpo-adriene
Environment=PYTHONUNBUFFERED=1
Environment=HF_HUB_DISABLE_XET=1
EnvironmentFile=-/opt/bpo-adriene/.env
ExecStart=/opt/bpo-adriene/.venv/bin/python -m uvicorn backend.app.main:app --host 0.0.0.0 --port 8055
Restart=always
RestartSec=5
TimeoutStopSec=20
KillSignal=SIGINT
ReadWritePaths=/opt/bpo-adriene/data /opt/bpo-adriene/logs
StandardOutput=append:/opt/bpo-adriene/logs/app.log
StandardError=append:/opt/bpo-adriene/logs/app.log
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
