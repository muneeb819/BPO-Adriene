# =============================================================================
#  BPO Adriene app (dashboard + campaigns + ARI listener) — systemd unit
#
#  Install (Linux server):
#     sudo cp deploy/bpo-adriene.service /etc/systemd/system/
#     sudo systemctl daemon-reload
#     sudo systemctl enable --now bpo-voice bpo-adriene
#     systemctl status bpo-adriene
#     journalctl -u bpo-adriene -f
#
#  `cli.py serve` is production mode: it runs the ARI listener for Asterisk and
#  the web app on PORT (see .env). Readiness: `python scripts/healthcheck.py`.
# =============================================================================
[Unit]
Description=BPO Adriene - AI voice fronter (ARI + web dashboard)
Documentation=file:///opt/bpo-adriene/DEPLOYMENT.md
After=network-online.target bpo-voice.service
Wants=network-online.target
# Start/stop together with the voice server; keep the app running if it is down.
Requires=bpo-voice.service

[Service]
Type=simple
User=bpo
Group=bpo
WorkingDirectory=/opt/bpo-adriene
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/opt/bpo-adriene/.env
ExecStart=/opt/bpo-adriene/.venv/bin/python cli.py serve
Restart=always
RestartSec=5
TimeoutStopSec=20
KillSignal=SIGINT
ReadWritePaths=/opt/bpo-adriene/data /opt/bpo-adriene/logs
StandardOutput=append:/opt/bpo-adriene/logs/app.log
StandardError=append:/opt/bpo-adriene/logs/app.log
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
