# =============================================================================
#  Local neural voice server (Piper/ONNX) — systemd unit
#
#  Install (Linux server):
#     sudo cp deploy/bpo-voice.service /etc/systemd/system/
#     sudo systemctl daemon-reload
#     sudo systemctl enable --now bpo-voice
#     systemctl status bpo-voice
#
#  It listens on 8880 and serves the OpenAI-compatible API the app calls.
#  Adjust User=, WorkingDirectory= and ExecStart= to your install path.
# =============================================================================
[Unit]
Description=BPO Adriene - local neural voice server (Piper/ONNX)
Documentation=file:///opt/bpo-adriene/DEPLOYMENT.md
After=network-online.target
Wants=network-online.target
# 8880 is a private port: keep it off the network unless you really need it.

[Service]
Type=simple
User=bpo
Group=bpo
WorkingDirectory=/opt/bpo-adriene
Environment=PYTHONUNBUFFERED=1
# --warm loads every voice at start-up, so the first call is as fast as the rest
ExecStart=/opt/bpo-adriene/.venv/bin/python scripts/neural_tts_server.py --host 0.0.0.0 --port 8880 --warm
Restart=always
RestartSec=3
TimeoutStopSec=15
# Voice models and logs live under the project directory
ReadWritePaths=/opt/bpo-adriene/data /opt/bpo-adriene/logs
StandardOutput=append:/opt/bpo-adriene/logs/voice-server.log
StandardError=append:/opt/bpo-adriene/logs/voice-server.log
# Light hardening (the server only needs its own tree and a port)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
