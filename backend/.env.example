# Adapter configuration example

# STT provider: mock | deepgram | google
STT_PROVIDER=mock
DEEPGRAM_API_KEY=

# TTS provider: mock | elevenlabs | azure
TTS_PROVIDER=mock
ELEVENLABS_API_KEY=

# LLM provider: mock | openai | local
LLM_PROVIDER=mock
OPENAI_API_KEY=

# Media bridge: mock | twilio | freeswitch
MEDIA_BRIDGE=mock

# Other settings
ENV=local
